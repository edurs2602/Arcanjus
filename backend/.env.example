DATABASE_URL=postgresql://arcanjus:arcanjus_dev@localhost:5432/arcanjus
JWT_SECRET=dev-secret-change-in-production-min-32-chars
PORT=3001
NODE_ENV=development

# Storage: "local" saves to disk, "cloud" uses S3
STORAGE_MODE=local
UPLOADS_DIR=./uploads

# Cloud storage (only needed when STORAGE_MODE=cloud)
# S3_BUCKET=arcanjus-images
# S3_REGION=sa-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=
