generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(200)
  description String?  @db.Text
  bannerUrl   String
  bannerAlt   String   @default("")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shirts Shirt[]

  @@index([active, order])
}

model Shirt {
  id              String       @id @default(uuid())
  name            String       @db.VarChar(200)
  description     String       @db.Text
  price           Decimal      @db.Decimal(10, 2)
  sizes           String[]
  color           String
  category        String
  active          Boolean      @default(true)
  collectionId    String?
  pipelineStatus  String       @default("pending")
  pipelineError   String?
  aiColor         String?
  aiType          String?
  aiDescription   String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  collection  Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images      ShirtImage[]
  clicks      ProductClickEvent[]

  @@index([active, category])
  @@index([active, color])
  @@index([collectionId])
}

model ShirtImage {
  id            String  @id @default(uuid())
  shirtId       String
  url           String
  alt           String
  sortOrder     Int     @default(0)
  isPrimary     Boolean @default(false)
  isAiGenerated Boolean @default(false)
  modelName     String?

  shirt Shirt @relation(fields: [shirtId], references: [id], onDelete: Cascade)

  @@index([shirtId, sortOrder])
}

model StoreInfo {
  id           String   @id @default(uuid())
  name         String
  address      String
  city         String
  state        String
  zipCode      String
  phone        String
  latitude     Decimal
  longitude    Decimal
  hoursJson    Json
  aboutTitle   String
  aboutContent String   @db.Text
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model PageViewEvent {
  id         String   @id @default(uuid())
  page       String
  referrer   String?
  deviceType String
  timestamp  DateTime @default(now())

  @@index([timestamp])
}

model ProductClickEvent {
  id         String   @id @default(uuid())
  shirtId    String?
  actionType String
  timestamp  DateTime @default(now())

  shirt Shirt? @relation(fields: [shirtId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([shirtId])
}
